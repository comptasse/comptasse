{
    "name": "@comptasse/application-api",
    "type": "module",
    "private": false,
    "scripts": {
        "dev": "tsx watch --conditions source ./src/server.ts",
        "build": "tsc --build",
        "start": "node ./build/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run ../../tests/api/unit",
        "test:integration": "vitest run ../../tests/api/integration",
        "test:cli": "vitest run ../../tests/cli"
    },
    "devDependencies": {
        "@types/node": "26.1.2",
        "tsx": "4.23.5",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@comptasse/application-metadata": "workspace:*",
        "@aws-sdk/client-s3": "3.1102.0",
        "@aws-sdk/s3-request-presigner": "3.1102.0",
        "drizzle-orm": "0.45.2",
        "hono": "4.13.0",
        "postgres": "3.4.9",
        "valibot": "1.4.2"
    }
}
